{
  "name": "laravel-egypt/datalens",
  "version": "0.1.0",
  "description": "A zero-config database management studio for Laravel.",
  "type": "library",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
    "livewire/livewire": "^3.0 || ^4.0"
  },
  "autoload": {
    "psr-4": {
      "LaravelEgypt\\DataLens\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "LaravelEgypt\\DataLens\\DataLensServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
